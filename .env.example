# Obtain an API key from https://platform.claude.com/settings/keys (API billing required).
ANTHROPIC_API_KEY=
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/noodo.sqlite
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only development permits false. Production must use HTTPS and true.
COOKIE_SECURE=false
USER_DAILY_REQUEST_LIMIT=50
GLOBAL_DAILY_TOKEN_LIMIT=1000000
HYPERLIQUID_WEIGHT_PER_MINUTE=900
# Tune to your Claude account limits; token-count calls also share this local budget.
ANTHROPIC_REQUESTS_PER_MINUTE=30
# disabled is opt-in AFTER your contract fixtures verify its semantics.
SUPPORTED_ACCOUNT_MODES=
# Required only for encrypted backups; openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=
