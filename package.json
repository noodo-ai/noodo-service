{
  "name": "noodo-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node scripts/run-node.mjs --env-file=.env --import tsx --watch src/index.ts",
    "build": "node scripts/run-node.mjs node_modules/typescript/bin/tsc",
    "typecheck": "node scripts/run-node.mjs node_modules/typescript/bin/tsc --noEmit",
    "lint": "node scripts/run-node.mjs node_modules/eslint/bin/eslint.js src tests scripts",
    "test": "node scripts/run-node.mjs node_modules/vitest/vitest.mjs run",
    "start": "node scripts/run-node.mjs dist/index.js",
    "user:create": "node scripts/run-node.mjs --env-file=.env --import tsx src/cli.ts user:create",
    "db:backup": "node scripts/run-node.mjs --env-file=.env --import tsx src/cli.ts backup",
    "db:verify": "node scripts/run-node.mjs --env-file=.env --import tsx src/cli.ts verify",
    "db:prune": "node scripts/run-node.mjs --env-file=.env --import tsx src/cli.ts prune",
    "upstream:check": "node scripts/run-node.mjs --import tsx src/check-upstream.ts",
    "models:list": "node scripts/run-node.mjs --env-file=.env --import tsx src/list-models.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@fastify/cookie": "^11.0.2",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.4.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.2",
    "lossless-json": "^4.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.10",
    "eslint": "^10.0.1",
    "globals": "^17.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.0.0"
  }
}
